# Docker / container support for the NP2 (Pong) GKI 5.10 kernel.
#
# Merged as a config fragment by Scripts/build_kernel.sh via merge_config.sh,
# on top of the LineageOS sm8475 gki_defconfig + vendor fragments.
#
# TRIMMED (v2, 2026-08-15): the v1 full fragment bootlooped the device. The
# kernel hung ~0.2s into boot (pstore console-ramoops captured only the version
# banner). v1 flipped 11 options over the known-good base; this v2 keeps only
# the 6 Docker actually needs for single-host use and drops the 5 optional ones
# most likely to perturb boot:
#   DROPPED: USER_NS (Docker optional; only for rootless/userns-remap; a
#            well-known Android early-boot breaker), VXLAN, MACVLAN, IPVLAN,
#            IP_VS (all swarm/overlay-only).
# Options already =y in the base (NAMESPACES, NET_NS, MEMCG, OVERLAY_FS, BRIDGE,
# VETH, NF_NAT, xt conntrack, etc.) are restated harmlessly; the ones this
# kernel actually lacks are the real delta and are marked NEEDED.

# --- namespaces (PID_NS is OFF on stock -> NEEDED; USER_NS intentionally omitted) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# --- cgroups (CGROUP_PIDS + CGROUP_DEVICE OFF on stock -> NEEDED) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y

# --- core container plumbing (POSIX_MQUEUE OFF on stock -> NEEDED) ---
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_POSIX_MQUEUE=y
CONFIG_OVERLAY_FS=y

# --- networking: bridge + veth + netfilter/NAT (BRIDGE_NETFILTER OFF -> NEEDED) ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_NF_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# --- the xt matches Docker's generated iptables need (ADDRTYPE OFF -> NEEDED) ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
