# Docker / container support for the NP2 (Pong) GKI 5.10 kernel.
#
# Merged as a config fragment by Scripts/build_kernel.sh via merge_config.sh,
# on top of the LineageOS sm8475 gki_defconfig + vendor fragments.
#
# Derived from Moby's kernel requirements (contrib/check-config.sh), keeping
# only the current 5.10 spellings. Options already =y in the base (NAMESPACES,
# NET_NS, MEMCG, OVERLAY_FS, BRIDGE, VETH, NF_NAT, xt conntrack) are restated
# harmlessly; the ones this kernel actually lacks are marked NEEDED.

# --- namespaces (PID_NS + USER_NS are OFF on stock -> NEEDED) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- cgroups (CGROUP_PIDS OFF on stock -> NEEDED) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y

# --- core container plumbing ---
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_POSIX_MQUEUE=y
CONFIG_OVERLAY_FS=y

# --- networking: bridge + veth + netfilter/NAT ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_NF_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# --- the xt matches Docker's generated iptables need (ADDRTYPE OFF -> NEEDED) ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# --- overlay networks / extra drivers (optional but cheap on GKI) ---
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
