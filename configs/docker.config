# BISECT-PROC: process/namespace/cgroup group ONLY (no netfilter additions).
# Pairs with branch bisect-net. Whichever RAM-boot resets contains the culprit
# behind the ~0.233s init-transition hard reset seen in v1/v2.

# --- namespaces (PID_NS is the delta) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# --- cgroups (CGROUP_PIDS + CGROUP_DEVICE are the delta; they bump CGROUP_SUBSYS_COUNT) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y

# --- core (POSIX_MQUEUE is the delta) ---
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_POSIX_MQUEUE=y
CONFIG_OVERLAY_FS=y
